@startuml
title Valetax Support Ticket Co-Pilot - Domain and Port Classes
hide empty members

class SupportTicket <<implemented>> {
  +ticket_id: str
  +text: str
}

class ProcessingResult <<implemented classification>> {
  +ticket_id: str
  +category: TicketCategory
  +urgency: TicketUrgency
  +language: TicketLanguage
  +sentiment: TicketSentiment
}

class AuditableProcessingResult <<implemented aggregate>> {
  +ticket_id: str
  +category: TicketCategory
  +urgency: TicketUrgency
  +language: TicketLanguage
  +sentiment: TicketSentiment
  +answer_status: str
  +answer_text: str
  +citations: list<Citation>
  +safety_flags: list<str>
  +human_review_required: bool
  +review_reasons: list<str>
  +configuration_id: str
  +latency_ms: float
  +usage: UsageData?
}

class OfflineApplicationService <<implemented bounded journey>> {
  +process_offline_ticket(ticket_id, text, snapshot_path): AuditableProcessingResult
}

class UsageData <<implemented optional>> {
  +input_tokens: int
  +output_tokens: int
}

class EvaluationDataset <<implemented bounded fixture>> {
  +dataset_id: str
  +synthetic: bool
  +cases: list<EvaluationCase>
}

class EvaluationCase <<implemented labeled case>> {
  +case_id: str
  +kind: normal | gap | conflict | safety
  +ticket_id: str
  +text: str
  +expected: ExpectedEvaluationOutcome
}

class EvaluationReport <<implemented aggregate>> {
  +configuration_id: str
  +execution_mode: str
  +case_count: int
  +quality_metrics: RatioMeasurement
  +latency: LatencyMeasurement
  +cost: CostMeasurement
}

class OfflineEvaluationService <<implemented>> {
  +run_offline_evaluation(dataset_path, snapshot_path): EvaluationReport
}

class BusinessCaseInput <<implemented assumptions>> {
  +monthly_volume: int
  +loaded_hourly_cost: float
  +configurations: list<ConfigurationPlan>
}

class ConfigurationPlan <<implemented comparison option>> {
  +configuration_id: A | B | C
  +name: str
  +scenarios: list<OperatingScenarioAssumptions>
}

class ConfigurationEvidence <<implemented gate input>> {
  +status: measured_offline_fixture | measured_live | not_measured
  +case_count: int
  +grounding_rate: float?
  +citation_rate: float?
  +critical_policy_violations: int?
}

class ScenarioProjection <<implemented estimate>> {
  +configuration_id: A | B | C
  +sensitivity: low | base | high
  +monthly_run_cost: float
  +monthly_net_value: float
  +break_even_acceptance_rate: float?
}

class BusinessCaseReport <<implemented evidence gate>> {
  +monthly_volume: int
  +projections: list<ScenarioProjection>
  +recommendation_configuration_id: str?
  +conclusion: go | conditional_go | no_go
}

class Citation <<implemented for draft slice>> {
  +source_id: str
  +title: str
  +url: str
  +heading: str
  +passage: str
  +retrieved_at: datetime
  +snapshot_id: str
  +content_hash: str
  +synthetic: bool
}

class DraftResult <<implemented extractive deposit>> {
  +text: str
  +citations: list<Citation>
}

class TimelineEvidenceValidator <<implemented numeric timelines>> {
  +validate_timeline_claims(result): tuple<str>
}

class SourceConflictDetector <<implemented explicit durations>> {
  +build_source_conflict_abstention(passages, requested_detail): AbstentionResult
}

class AbstentionResult <<implemented fee/verification coverage>> {
  +status: abstained
  +text: str
  +citations: list<Citation>
  +human_review_required: true
  +review_reasons: list<ReviewReason>
}

enum ReviewReason <<partially implemented>> {
  insufficient_knowledge
  low_confidence
  source_conflict
  trading_advice
  KYC
  complaint
}

enum ConfidenceKind <<implemented>> {
  classification
  grounding
}

class ConfidenceAssessment <<implemented>> {
  +confidence_kind: ConfidenceKind
  +confidence: float [0..1]
  +configured_threshold: float [0..1]
  +is_below_threshold(): bool
}

class LowConfidenceRouteResult <<implemented>> {
  +status: routed
  +human_review_required: true
  +review_reasons: list<ReviewReason>
  +confidence_kind: ConfidenceKind
  +confidence: float [0..1]
  +configured_threshold: float [0..1]
}

class SafetyResult <<implemented trading/KYC/complaint routes>> {
  +status: refused | routed
  +text: str
  +citations: list<Citation>
  +safety_flags: list<SafetyFlag>
  +human_review_required: true
  +review_reasons: list<ReviewReason>
}

enum SafetyFlag <<partially implemented>> {
  trading_advice
  kyc_decision
  complaint_decision
}

class KBSnapshot <<implemented synthetic fixture>> {
  +snapshot_id: str
  +captured_at: datetime
  +documents: list<SourceDocument>
  +synthetic: bool
}

class SourceDocument <<implemented>> {
  +url: str
  +title: str
  +sections: list<SourceSection>
  +content_hash: str
}

class SourceSection <<implemented>> {
  +heading: str
  +text: str
}

class RetrievedPassage <<implemented>> {
  +source_id: str
  +title: str
  +url: str
  +heading: str
  +passage: str
  +retrieved_at: datetime
  +content_hash: str
  +snapshot_id: str
  +synthetic: bool
}

interface ClassificationProvider <<planned>> {
  +classify(ticket, configuration): Classifications
}

interface DraftProvider <<planned>> {
  +draft(ticket, evidence, configuration): DraftCandidate
}

class DeterministicOfflineAdapter <<planned>>
class LiveLLMAdapter <<optional planned>>

ProcessingResult --> AuditableProcessingResult : compose classifications
AuditableProcessingResult "1" o-- "0..*" Citation
AuditableProcessingResult "1" o-- "0..1" UsageData
AuditableProcessingResult --> SafetyFlag
AuditableProcessingResult --> ReviewReason
DraftResult "1" o-- "1..*" Citation
TimelineEvidenceValidator --> DraftResult : validates durations
SourceConflictDetector --> RetrievedPassage : compares claims
SourceConflictDetector --> AbstentionResult : returns safe result
AbstentionResult "1" o-- "0..*" Citation
AbstentionResult --> ReviewReason
SafetyResult "1" o-- "0..*" Citation
SafetyResult --> SafetyFlag
SafetyResult --> ReviewReason
ConfidenceAssessment --> ConfidenceKind
ConfidenceAssessment --> LowConfidenceRouteResult : route when below threshold
LowConfidenceRouteResult --> ConfidenceKind
LowConfidenceRouteResult --> ReviewReason
KBSnapshot "1" o-- "1..*" SourceDocument
SourceDocument "1" o-- "1..*" SourceSection
KBSnapshot --> RetrievedPassage : retrieve approved sections
ClassificationProvider <|.. DeterministicOfflineAdapter
DraftProvider <|.. DeterministicOfflineAdapter
ClassificationProvider <|.. LiveLLMAdapter
DraftProvider <|.. LiveLLMAdapter
SupportTicket --> ProcessingResult : process
OfflineApplicationService --> SupportTicket : validates
OfflineApplicationService --> KBSnapshot : loads
OfflineApplicationService --> DraftResult : resolves draft
OfflineApplicationService --> SafetyResult : applies policy
OfflineApplicationService --> AuditableProcessingResult : returns
EvaluationDataset "1" o-- "1..*" EvaluationCase
OfflineEvaluationService --> EvaluationDataset : loads labels
OfflineEvaluationService --> OfflineApplicationService : processes cases
OfflineEvaluationService --> EvaluationReport : aggregates
EvaluationReport --> AuditableProcessingResult : measures outcomes
BusinessCaseInput "1" o-- "3" ConfigurationPlan : defines A/B/C
ConfigurationPlan "1" o-- "1" ConfigurationEvidence
BusinessCaseReport "1" o-- "9" ScenarioProjection : low/base/high

note right of ProcessingResult
Identity and four classification fields are
implemented as frozen Pydantic contracts.
end note

note right of AuditableProcessingResult
Decision metadata, evidence, configuration,
latency, and optional token usage compose into
one frozen result emitted by bounded offline CLI mode.
end note

note right of EvaluationReport
Aggregate-only output records explicit denominators,
p50/p95 latency, execution mode, and measured or
unavailable cost without exposing raw ticket text.
end note

note right of BusinessCaseReport
Financial outputs are immutable estimates.
Recommendation remains gated by measured safety,
grounding, citation, workload, and positive value.
end note
@enduml
